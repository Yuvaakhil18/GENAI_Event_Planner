# Event Planning Assistant Environment Variables
# Copy this file to .env and configure as needed.

# Optional: Anthropic API Key for real-time Claude Haiku creative recommendations.
# When omitted, the app automatically falls back to curated heuristics.
ANTHROPIC_API_KEY=

# Optional: Model identifier (defaults to claude-haiku-5-5)
PLANNER_MODEL=claude-haiku-5-5

# Optional: Request timeout in seconds (defaults to 15.0)
PLANNER_TIMEOUT_SECONDS=15.0

